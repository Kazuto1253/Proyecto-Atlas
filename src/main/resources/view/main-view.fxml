<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pe.upeu.atlas.controller.MainController">
    <BorderPane styleClass="raiz">
        <left>
            <VBox fx:id="menuLateral" styleClass="menu-lateral" spacing="4"
                  prefWidth="210" minWidth="210" maxWidth="210">
                <padding><Insets top="14" right="10" bottom="14" left="10"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="cabecera-menu">
                    <padding><Insets left="8" bottom="14"/></padding>
                    <FontIcon iconLiteral="fth-mic" iconSize="22" styleClass="icono-marca"/>
                    <Label fx:id="lblMarca" text="Atlas" styleClass="marca-menu"/>
                </HBox>
                <VBox fx:id="contenedorBotones" spacing="4" VBox.vgrow="ALWAYS"/>
                <HBox fx:id="chipUsuario" alignment="CENTER_LEFT" spacing="10" styleClass="chip-usuario">
                    <FontIcon iconLiteral="fth-user" iconSize="18" styleClass="icono-marca"/>
                    <VBox fx:id="textosUsuario" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblUsuario" styleClass="nombre-usuario" maxWidth="130"/>
                        <Label fx:id="lblRol" styleClass="text-small, text-muted"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnFlotante" text="Modo flotante" onAction="#alModoFlotante"
                        styleClass="boton-menu" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-minimize-2"/></graphic>
                    <tooltip><Tooltip text="Asistente pequeño siempre visible"/></tooltip>
                </Button>
                <Button fx:id="btnSalir" text="Cerrar sesión" onAction="#alCerrarSesion"
                        styleClass="boton-menu" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                </Button>
                <Button fx:id="btnContraer" onAction="#alContraerMenu" styleClass="boton-menu, flat"
                        maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fth-chevrons-left"/></graphic>
                </Button>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="contenido"/>
        </center>
        <bottom>
            <HBox spacing="24" styleClass="barra-estado">
                <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
                <Label fx:id="lblModelo" styleClass="text-small"/>
                <Label fx:id="lblCarpeta" styleClass="text-small"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblEntorno" styleClass="text-small"/>
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>
