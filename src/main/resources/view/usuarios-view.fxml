<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.upeu.atlas.controller.UsuariosController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="24" right="32" bottom="12" left="32"/></padding>
            <VBox spacing="4">
                <Label text="Usuarios" styleClass="titulo-vista"/>
                <Label fx:id="lblResumen" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nuevo usuario" styleClass="accent" onAction="#alCrearUsuario">
                <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="0" right="32" bottom="12" left="32"/></padding>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="240"/>
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="colAcceso" text="Último acceso" prefWidth="160"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnActivar" text="Desactivar" onAction="#alCambiarActivo">
                    <graphic><FontIcon iconLiteral="fth-power"/></graphic>
                </Button>
                <Button fx:id="btnRol" text="Cambiar rol" onAction="#alCambiarRol">
                    <graphic><FontIcon iconLiteral="fth-shield"/></graphic>
                </Button>
                <Button fx:id="btnClave" text="Restablecer contraseña" onAction="#alRestablecerClave">
                    <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>
