<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.upeu.atlas.controller.SanchezUsuariosController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="24" right="32" bottom="12" left="32"/></padding>
            <VBox spacing="4">
                <Label text="Usuarios" styleClass="titulo-vista"/>
                <Label fx:id="sanchezlblResumen" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nuevo usuario" styleClass="accent" onAction="#marcaalCrearUsuario">
                <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="0" right="32" bottom="12" left="32"/></padding>
            <TableView fx:id="marcatabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="sanchezcolNombre" text="Nombre" prefWidth="240"/>
                    <TableColumn fx:id="marcacolUsuario" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="sanchezcolRol" text="Rol" prefWidth="120"/>
                    <TableColumn fx:id="marcacolEstado" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="marcacolAcceso" text="Último acceso" prefWidth="160"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="marcabtnActivar" text="Desactivar" onAction="#marcaalCambiarActivo">
                    <graphic><FontIcon iconLiteral="fth-power"/></graphic>
                </Button>
                <Button fx:id="sanchezbtnRol" text="Cambiar rol" onAction="#sanchezalCambiarRol">
                    <graphic><FontIcon iconLiteral="fth-shield"/></graphic>
                </Button>
                <Button fx:id="sanchezbtnClave" text="Restablecer contraseña" onAction="#marcaalRestablecerClave">
                    <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>
